{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Qdrant engine config",
  "type": "object",
  "properties": {
    "replicas": { "type": "integer", "minimum": 1 },
    "shards": { "type": "integer", "minimum": 1 },
    "quantization": { "type": "string", "enum": ["none", "scalar", "product", "binary"] }
  }
}
