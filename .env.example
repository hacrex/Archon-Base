# Archon Base local development configuration.
# Copy to .env for Compose or export these variables before `make run`.

ARCHON_API_ADDR=127.0.0.1:8080
ARCHON_DB_URL=postgres://archon:archon@127.0.0.1:5432/archon?sslmode=disable
ARCHON_MIGRATIONS_DIR=./migrations
ARCHON_ORGANIZATION_ID=00000000-0000-0000-0000-000000000001
ARCHON_QDRANT_URL=http://127.0.0.1:6333

POSTGRES_USER=archon
POSTGRES_PASSWORD=archon
POSTGRES_DB=archon
